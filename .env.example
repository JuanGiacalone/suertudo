# Copiar a .env y completar. NUNCA commitear el .env.
# Ningún valor de este archivo es un secreto real: son los valores de
# desarrollo local. Los secretos de producción viven en el secret manager.

# --- base de datos ---------------------------------------------------------
DATABASE_URL=postgres://suertudo:suertudo@127.0.0.1:5432/suertudo
DATABASE_URL_TEST=postgres://suertudo:suertudo@127.0.0.1:5432/suertudo_test
DATABASE_MAX_CONNECTIONS=10

# --- iii -------------------------------------------------------------------
# Motor de iii. La URL la inyecta el compose daemon; el valor local es el
# default. Ver infra/iii/VERSION para las versiones pineadas.
III_URL=ws://127.0.0.1:49134
III_NAMESPACE=suertudo
RUST_LOG=info

# --- api ------------------------------------------------------------------
API_PORT=3111

# --- identidad -------------------------------------------------------------
# En desarrollo se puede usar un magic link fijo para probar sin correo.
# En staging y produccion estos valores vienen del secret manager.
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- correo ----------------------------------------------------------------
# Mailpit en desarrollo: http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@suertudo.local

# --- servicios -------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/%2f
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=suertudo
S3_ACCESS_KEY=suertudo
S3_SECRET_KEY=suertudo

# --- ia --------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=
