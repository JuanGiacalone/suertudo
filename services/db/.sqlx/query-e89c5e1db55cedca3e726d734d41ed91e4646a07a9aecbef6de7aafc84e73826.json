  "query": "\n        SELECT id, business_id, number_pool_size, prize_quantity\n        FROM raffles\n        WHERE status = 'closed'\n          AND draws_at <= now()\n          AND NOT EXISTS (SELECT 1 FROM draws d WHERE d.raffle_id = raffles.id)\n        ORDER BY draws_at\n        LIMIT $1\n        ",
